# Firebase Configuration
# Copy this file to .env and fill in your Firebase project credentials
# You can find these values in your Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id
# Note: measurementId is optional, only needed if using Firebase Analytics

# ImgBB API Configuration
# Get your API key from https://api.imgbb.com/
VITE_IMGBB_API_KEY=51c3a67a9557fa69232ca4f06687bc35

# Cloudinary Configuration
# Get your cloud name from https://cloudinary.com/
VITE_CLOUDINARY_CLOUD_NAME=manachennuru
# Upload preset name (unsigned preset configured in Cloudinary dashboard)
# Configure an unsigned upload preset in Cloudinary dashboard and set its name here
# Default: manachennuru (can be customized)
VITE_CLOUDINARY_UPLOAD_PRESET=manachennuru

# Admin Configuration
# Comma-separated list of admin email addresses
# Example: VITE_ADMIN_EMAILS=admin1@example.com,admin2@example.com
VITE_ADMIN_EMAILS=

